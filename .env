# ============ 模型URL接口设置 ============
# 嵌入模型 API 配置
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings

# 对话模型 API 设置
CHAT_API_URL=https://api.siliconflow.cn/v1/chat/completions

# 重排序模型 API 设置
RERANKER_API_URL=https://api.siliconflow.cn/v1/rerank

# ============ SiliconFlow API 配置 ============
SILICONFLOW_API_KEY=API-key

# ============ 模型选择 ============
# LLM模型（对话模型）
LLM_MODEL=Qwen/Qwen3-32B

# 嵌入模型（向量化模型）
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# 重排序模型
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# ============ 重排序配置 ============
# 重排序方法: none | embedding | true_reranker
RERANK_METHOD=true_reranker

# 重排序指令（仅对Qwen3-Reranker有效）
# 示例: "Given a web search query, retrieve relevant passages that answer the query"
RERANK_INSTRUCTION="Given a web search query, retrieve relevant passages that answer the query"

# ============ 向量数据库配置 ============
# Chroma数据库目录
CHROMA_DIR=./chroma_db

# 集合名称
COLLECTION_NAME=my_documents

# ============ 系统参数 ============
# 初始检索文档数量 (1-100)
RETRIEVE_K=20

# 最终返回文档数量 (1-20)
TOP_K=5

# LLM温度参数 (0.0-2.0)
TEMPERATURE=0.7

# LLM最大生成长度 (1-8000)
MAX_TOKENS=2000

# ============ 网络配置 ============
# API请求超时时间(秒)
TIMEOUT=120

# 最大重试次数
MAX_RETRIES=3

# ============ 日志配置 ============
# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=rag_system.log

# ============ 可选功能 ============
# 是否启用嵌入缓存 (true/false)
ENABLE_CACHE=true

# 缓存大小 (嵌入向量数量)
CACHE_SIZE=1000

# 是否启用历史对话 (true/false)
ENABLE_HISTORY=true

# 历史对话轮数限制
HISTORY_LIMIT=5

# ============ 向量化存储设置 ============
# 文本分块配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 批量处理目录
DATA_DIRECTORY=./测试数据

# 支持的文件类型（逗号分隔）
SUPPORTED_FILE_EXTENSIONS=.txt,.md,.pdf

# 查询配置
QUERY_TOP_K=5

